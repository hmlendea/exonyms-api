<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ExonymsAPI.ArchitectureTests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="NUnit" Version="4.5.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="TngTech.ArchUnitNET.NUnit" Version="0.13.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ExonymsAPI/ExonymsAPI.csproj" />
    <None Include="../ExonymsAPI/ExonymsAPI.csproj"
          Link="ProductionProjects/ExonymsAPI.csproj"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>